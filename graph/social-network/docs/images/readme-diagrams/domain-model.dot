digraph domain {
    rankdir=LR;
    splines=ortho;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    subgraph cluster_vertices {
        label="Vertices";
        style=dashed;
        Person [label="Person\n──────\npersonId\nname\ntitle\nlocation", fillcolor="#d0e8ff"];
        Company [label="Company\n──────\ncompanyId\nname\nindustry\nlocation", fillcolor="#d0ffe8"];
    }

    Person -> Person [label="KNOWS\n(bidirectional)\nsince, strength", color="#4a90d9", style=bold];
    Person -> Person [label="FOLLOWS\n(one-way)", color="#e9854a", style=dashed];
    Person -> Company [label="WORKS_AT\nrole, startDate\nisCurrent", color="#7ac27a"];
}

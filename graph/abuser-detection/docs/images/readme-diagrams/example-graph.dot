digraph example {
    rankdir=LR;
    splines=ortho;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    subgraph cluster_users {
        label="Users";
        style=dashed;
        UserA [label="User A\n(fraudster)", fillcolor="#ffd0d0"];
        UserB [label="User B\n(accomplice)", fillcolor="#ffd0d0"];
        UserC [label="User C\n(legitimate?)", fillcolor="#ffe8c0"];
    }
    subgraph cluster_ids {
        label="Identifiers";
        style=dashed;
        Dev1 [label="Device-1\n(android)", fillcolor="#d0e8ff", shape=diamond];
        IP1  [label="IP 10.0.0.1", fillcolor="#e0d0ff", shape=diamond];
        Phone1 [label="Phone\n(hashed)", fillcolor="#d0ffe8", shape=diamond];
        Pay1 [label="Payment\n(token)", fillcolor="#fff0c0", shape=diamond];
    }
    UserA -> Dev1 [label="USES_DEVICE"];
    UserB -> Dev1 [label="USES_DEVICE"];
    UserA -> IP1  [label="USES_IP"];
    UserB -> IP1  [label="USES_IP"];
    UserA -> Phone1 [label="HAS_PHONE"];
    UserA -> Pay1   [label="USES_PAYMENT"];
    UserB -> Pay1   [label="USES_PAYMENT"];
    UserA -> UserB  [label="REFERRED_BY", style=dashed, color=gray];
    UserC -> IP1    [label="USES_IP"];
}

digraph recommendation_architecture {
    graph [rankdir=TB, splines=ortho, nodesep=0.8, ranksep=1.0, fontname="Helvetica"]
    node [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    // Domain Layer
    subgraph cluster_domain {
        label="Domain Model"
        style=filled; color="#e8f4f8"; fontsize=12;

        User [label="User\n(userId, name)", fillcolor="#aed6f1", shape=ellipse]
        Product [label="Product\n(productId, name, category)", fillcolor="#a9dfbf", shape=ellipse]

        User -> User [label="FOLLOWS", style=dashed, color="#7d3c98"]
        User -> Product [label="PURCHASED\n(rating, purchasedAt)", color="#e67e22"]
    }

    // Service Layer
    subgraph cluster_service {
        label="Service Layer"
        style=filled; color="#fef9e7"; fontsize=12;

        RecService [label="RecommendationService\n(blocking)", fillcolor="#f9e79f"]
        RecSuspend [label="RecommendationSuspendService\n(coroutine)", fillcolor="#fad7a0"]
    }

    // Algorithm Layer
    subgraph cluster_algorithm {
        label="Recommendation Algorithms"
        style=filled; color="#eaf2ff"; fontsize=12;

        CF [label="recommendProducts()\nCollaborative Filtering\n(co-buyer graph)", fillcolor="#d6eaf8"]
        FOAF [label="recommendFollows()\nFOAF on FOLLOWS\n(2-hop traversal)", fillcolor="#d5f5e3"]
    }

    // Backend Layer
    subgraph cluster_backends {
        label="Graph Backends"
        style=filled; color="#f9ebea"; fontsize=12;

        TinkerGraph [label="TinkerGraph\n(in-memory)", fillcolor="#f5cba7", shape=cylinder]
        Neo4j [label="Neo4j\n(Testcontainer)", fillcolor="#fadbd8", shape=cylinder]
        Memgraph [label="Memgraph\n(Testcontainer)", fillcolor="#f1948a", shape=cylinder]
    }

    // Connections
    RecService -> CF [label="calls"]
    RecService -> FOAF [label="calls"]
    RecSuspend -> CF [label="suspend calls", style=dashed]
    RecSuspend -> FOAF [label="suspend calls", style=dashed]

    CF -> TinkerGraph [label="GraphOperations"]
    CF -> Neo4j [label="GraphOperations"]
    CF -> Memgraph [label="GraphOperations"]

    FOAF -> TinkerGraph [style=dashed]
    FOAF -> Neo4j [style=dashed]
    FOAF -> Memgraph [style=dashed]

    User -> RecService [label="userVertexId", style=dotted]
    Product -> RecService [label="productVertexId", style=dotted]
}

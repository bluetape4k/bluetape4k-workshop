digraph domain_model {
    graph [rankdir=LR, splines=curved, nodesep=1.2, ranksep=2.0, fontname="Helvetica", bgcolor="transparent"]
    node [fontname="Helvetica", fontsize=12]
    edge [fontname="Helvetica", fontsize=10]

    // Vertices
    User [label="User\nuserId · name", shape=ellipse, style=filled,
          fillcolor="#aed6f1", color="#2471a3", fontcolor="#154360"]
    Product [label="Product\nproductId · name · category", shape=ellipse, style=filled,
             fillcolor="#a9dfbf", color="#1e8449", fontcolor="#145a32"]

    // Edges
    User -> User    [label="FOLLOWS", style=dashed, color="#7d3c98", fontcolor="#7d3c98"]
    User -> Product [label="PURCHASED\n(rating, purchasedAt)", color="#e67e22", fontcolor="#e67e22"]
}

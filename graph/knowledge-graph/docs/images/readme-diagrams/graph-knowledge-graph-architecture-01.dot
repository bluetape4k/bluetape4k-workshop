digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.7, ranksep=0.8];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#90a4c8"];
  schema [xlabel="Schema Objects"];
  blocking_service [xlabel="KnowledgeGraphService"];
  suspend_service [xlabel="KnowledgeGraphSuspendService"];
  graph_ops [xlabel="GraphOperations"];
  graph_suspend_ops [xlabel="GraphSuspendOperations"];
  tinkergraph [xlabel="TinkerGraph"];
  neo4j [xlabel="Neo4j"];
  memgraph [xlabel="Memgraph"];
  schema -> blocking_service;
  schema -> suspend_service;
  blocking_service -> graph_ops;
  suspend_service -> graph_suspend_ops;
  graph_ops -> tinkergraph;
  graph_ops -> neo4j;
  graph_suspend_ops -> neo4j;
  graph_suspend_ops -> memgraph;
}

digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.75",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.14,0.10"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Entry / Tests\nExposedMvcJdbcApp /\nAbstractMvcJdbcTest", fillcolor="#FFF8E7"];
  api [label="API / Adapter\nAuthorController /\nBookController /\nGlobalExceptionHandler", fillcolor="#EEF7FF"];
  service [label="Service / Domain\nAuthorService /\nDatabaseInitializer /\nOrderService", fillcolor="#F1F8E9"];
  infra [label="Repository / Infra\nAuthorDTO / AuthorMappers /\nAuthorRepository /\nBookRepository", fillcolor="#F5F0FF"];
  bt [label="bluetape4k APIs\nworkshop / junit5 /\nassertions", fillcolor="#EAF7F0"];
  runtime [label="Runtime\nSQL / R2DBC /\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> api [label="calls"];
  api -> service [label="uses"];
  service -> infra [label="uses"];
  infra -> bt [label="uses"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

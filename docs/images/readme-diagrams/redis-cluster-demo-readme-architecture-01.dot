digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Redis Cluster Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Abstract Redis Cluster Test\ncluster", fillcolor="#FFF8E7"];
  entry2 [label="Basic Usage Test\nbasic", fillcolor="#FFF8E7"];
  entry3 [label="Bluetape4k Lettuce Usage Test\nbasic", fillcolor="#FFF8E7"];
  entry4 [label="Number Service Test\nservice component", fillcolor="#FFF8E7"];
  service0 [label="Number Service\nservice component", fillcolor="#F1F8E9"];
  infra0 [label="Spring boot starter data redis lib\nRedis Client Layer", fillcolor="#F5F0FF"];
  infra1 [label="Spring boot autoconfigure lib\nRedis Client Layer", fillcolor="#F5F0FF"];
  infra2 [label="Spring boot starter test\nRedis Client Layer", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Redis APIs", fillcolor="#EAF7F0"];
  bt1 [label="core\nbluetape4k Redis APIs", fillcolor="#EAF7F0"];
  bt2 [label="jackson3\nbluetape4k Redis APIs", fillcolor="#EAF7F0"];
  runtime0 [label="SQL / R2DBC\nRedis Runtime", fillcolor="#FFF1F1"];
  runtime1 [label="Redis\nRedis Runtime", fillcolor="#FFF1F1"];
  runtime2 [label="Testcontainers\nRedis Runtime", fillcolor="#FFF1F1"];

  entry4 -> service0 [label="starts"];
  service0 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}

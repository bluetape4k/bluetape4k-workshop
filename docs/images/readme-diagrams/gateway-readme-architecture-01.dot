digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.75",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.14,0.10"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Entry / Tests\nApiGatewayDemoApplication\n/ CustomerApplication /\nAbstractGatewayTest", fillcolor="#FFF8E7"];
  api [label="API / Adapter\nGatewayConfig /\nSwaggerConfig /\nIndexController", fillcolor="#EEF7FF"];
  runtime [label="Runtime\nRedis / AWS / S3 /\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> api [label="calls"];
  api -> runtime [label="uses"];
}

  api2 [label="Async User Rate Limit Web Filter\nfilter", fillcolor="#EEF7FF"];
  api3 [label="User Rate Limit Web Filter\nfilter", fillcolor="#EEF7FF"];
  service0 [label="Key Resolver\ncomponents", fillcolor="#F1F8E9"];

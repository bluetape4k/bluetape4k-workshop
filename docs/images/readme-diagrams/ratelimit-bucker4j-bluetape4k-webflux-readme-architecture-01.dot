    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Rate Limiter Webflux Application\napplication bootstrap", fillcolor="#FFF8E7"];

  entry2 [label="Coroutine Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  entry3 [label="Reactive Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  api0 [label="Coroutine Controller\nHTTP adapter", fillcolor="#EEF7FF"];

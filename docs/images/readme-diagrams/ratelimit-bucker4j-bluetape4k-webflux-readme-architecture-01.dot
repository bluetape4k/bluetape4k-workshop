  service2 [label="User Key Resolver\ncomponents", fillcolor="#F1F8E9"];
  service3 [label="Bucket4j Config\nconfiguration", fillcolor="#F1F8E9"];
  service4 [label="Header Utils\nutils", fillcolor="#F1F8E9"];
  infra0 [label="Lettuce Config\nconfiguration", fillcolor="#F5F0FF"];

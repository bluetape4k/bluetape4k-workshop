digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Rate-limit Surface\nRateLimiterWebfluxApplication\nAbstractRateLimiterApplicationTest\nCoroutineControllerTest\nRatelimit Bucker4j Bluetape4k", fillcolor="#FFF8E7"];
  api [label="Web Filter / Controller\nCoroutineController\nReactiveController\nAsyncUserRateLimitWebFilter\nUserRateLimitWebFilter", fillcolor="#EEF7FF"];
  service [label="Policy Enforcement\nKeyResolver\nRateLimitTargetProvider\nUserKeyResolver\nBucket4jConfig", fillcolor="#F1F8E9"];
  infra [label="Bucket Storage Layer\nLettuceConfig\nTestRedisConfig", fillcolor="#F5F0FF"];
  bt [label="bluetape4k RateLimit APIs\nworkshop\njackson3\nspring", fillcolor="#EAF7F0"];
  runtime [label="Bucket Runtime\nRedis\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> service [label="delegates"];
  service -> infra [label="persists / publishes"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

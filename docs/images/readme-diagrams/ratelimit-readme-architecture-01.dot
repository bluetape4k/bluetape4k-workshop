digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Entry & Verification\nRateLimiterWebfluxApplication\nBucket4jAdvancedApplication\nCaffeineApplication\nAbstractRateLimiterApplicationTest", fillcolor="#FFF8E7"];
  api [label="API & Adapters\nCoroutineController\nReactiveController\nAsyncUserRateLimitWebFilter\nUserRateLimitWebFilter", fillcolor="#EEF7FF"];
  service [label="Service & Domain\nKeyResolver\nRateLimitTargetProvider\nUserKeyResolver\nBucket4jConfig", fillcolor="#F1F8E9"];
  infra [label="Repository & Infra\nLettuceConfig\nTestRedisConfig\nRequestUtils\nLettuceConfiguration", fillcolor="#F5F0FF"];
  runtime [label="Runtime\nRedis\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> service [label="delegates"];
  service -> infra [label="persists / publishes"];
  infra -> runtime [label="backs"];
}

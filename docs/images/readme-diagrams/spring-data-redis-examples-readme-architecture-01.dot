digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Entry & Verification\nRedisApplication\nAbstractRedisTest\nGeoOperationsTest\nSpring Data Redis Examples tests", fillcolor="#FFF8E7"];
  api [label="API & Adapters\nCapturingStreamListener", fillcolor="#EEF7FF"];
  infra [label="Repository & Infra\nActor\nMovie\nMovieActor\nMovieActorReference", fillcolor="#F5F0FF"];
  bt [label="bluetape4k APIs\nworkshop\nredis\nspring", fillcolor="#EAF7F0"];
  runtime [label="Runtime\nSQL / R2DBC\nRedis\nKafka", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> infra [label="persists / publishes"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

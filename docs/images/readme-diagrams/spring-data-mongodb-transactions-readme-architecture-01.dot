digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Entry & Verification\nAbstractMongodbTest\nCoroutineManagedTransitionServiceTest\nSpring Data Mongodb Transactions\ntests", fillcolor="#FFF8E7"];
  service [label="Service & Domain\nCoroutineManagedTransitionService\nTransitionService\nReactiveManagedTransitionService\nReactiveTransitionService", fillcolor="#F1F8E9"];
  infra [label="Repository & Infra\nProcess\nState\nCoroutineProcessRepository\nProcessRepository", fillcolor="#F5F0FF"];
  bt [label="bluetape4k APIs\ntestcontainers\ncoroutines\nidgenerators", fillcolor="#EAF7F0"];
  runtime [label="Runtime\nMongoDB\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> service [label="delegates"];
  service -> infra [label="persists / publishes"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

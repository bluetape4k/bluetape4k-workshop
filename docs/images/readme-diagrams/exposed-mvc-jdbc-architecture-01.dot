digraph ExposedMvcJdbc {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9];
  newrank=true;
  nodesep=0.8;
  ranksep=1.0;

  // Layer: Presentation
  subgraph cluster_presentation {
    label="Presentation"; style=rounded; color="#B8D4F0"; fillcolor="#E8F3FF";
    AuthorController [label="AuthorController\n@RestController\n/api/v1/authors", fillcolor="#E8F3FF"];
    BookController [label="BookController\n@RestController\n/api/v1/books", fillcolor="#E8F3FF"];
    OrderController [label="OrderController\n@RestController\n/api/v1/orders", fillcolor="#E8F3FF"];
    ProductController [label="ProductController\n@RestController\n/api/v1/products", fillcolor="#E8F3FF"];
  }

  // Layer: Service
  subgraph cluster_service {
    label="Service"; style=rounded; color="#B0DAC0"; fillcolor="#EAF7EF";
    AuthorService [label="AuthorService\n@Transactional", fillcolor="#EAF7EF"];
    OrderService [label="OrderService\n@Transactional\nlock ordering + FOR UPDATE", fillcolor="#EAF7EF"];
  }

  // Layer: Repository
  subgraph cluster_repository {
    label="Repository"; style=rounded; color="#C8B8E8"; fillcolor="#F1ECFF";
    AuthorRepository [label="AuthorRepository\n: LongAuditableJdbcRepository", fillcolor="#F1ECFF"];
    BookRepository [label="BookRepository\n: LongJdbcRepository", fillcolor="#F1ECFF"];
    OrderRepository [label="OrderRepository\n(plain Exposed)", fillcolor="#F1ECFF"];
    OrderLineRepository [label="OrderLineRepository\n(plain Exposed)", fillcolor="#F1ECFF"];
    ProductRepository [label="ProductRepository\n(plain Exposed · forUpdate)", fillcolor="#F1ECFF"];
  }

  // Layer: Schema
  subgraph cluster_schema {
    label="Schema"; style=rounded; color="#E8D5A0"; fillcolor="#FFF3D9";
    AuthorTable [label="AuthorTable\nAuditableLongIdTable\naudit cols", fillcolor="#FFF3D9"];
    BookTable [label="BookTable\nLongIdTable\nFK→Author", fillcolor="#FFF3D9"];
    OrderTable [label="OrderTable\nTable\nstatus enum", fillcolor="#FFF3D9"];
    OrderLineTable [label="OrderLineTable\nTable\nFK→Order, FK→Product", fillcolor="#FFF3D9"];
    ProductTable [label="ProductTable\nTable\nstock + price", fillcolor="#FFF3D9"];
  }

  // Database
  PostgreSQL [shape=cylinder, label="PostgreSQL", fillcolor="#FDECEF", color="#DC6B82"];

  // Edges: Controller → Service
  AuthorController -> AuthorService;
  BookController -> AuthorService;
  OrderController -> OrderService;
  ProductController -> OrderService;

  // Edges: Service → Repository
  AuthorService -> AuthorRepository;
  AuthorService -> BookRepository;
  OrderService -> OrderRepository;
  OrderService -> OrderLineRepository;
  OrderService -> ProductRepository;

  // Edges: Repository → Table (implicit via table reference)
  AuthorRepository -> AuthorTable;
  BookRepository -> BookTable;
  OrderRepository -> OrderTable;
  OrderLineRepository -> OrderLineTable;
  ProductRepository -> ProductTable;

  // FK relationships
  BookTable -> AuthorTable [style=dashed, label="FK", color="#45A7A1"];
  OrderLineTable -> OrderTable [style=dashed, label="FK", color="#45A7A1"];
  OrderLineTable -> ProductTable [style=dashed, label="FK", color="#45A7A1"];

  // Schema → DB
  AuthorTable -> PostgreSQL;
  BookTable -> PostgreSQL;
  OrderTable -> PostgreSQL;
  OrderLineTable -> PostgreSQL;
  ProductTable -> PostgreSQL;
}

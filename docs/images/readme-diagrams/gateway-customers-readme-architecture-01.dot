digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Customer Application\napplication bootstrap", fillcolor="#FFF8E7"];
  api0 [label="Customer Config\nconfiguration", fillcolor="#EEF7FF"];
  api1 [label="Observation Config\nconfiguration", fillcolor="#EEF7FF"];
  api2 [label="Swagger Config\nconfiguration", fillcolor="#EEF7FF"];
  api3 [label="Customer Contoller\nHTTP adapter", fillcolor="#EEF7FF"];
  api4 [label="Redirect Web Filter\nfilters", fillcolor="#EEF7FF"];
  infra0 [label="Spring boot autoconfigure lib\nFramework Layer", fillcolor="#F5F0FF"];
  infra1 [label="Spring boot autoconfigure processor\nFramework Layer", fillcolor="#F5F0FF"];
  infra2 [label="Spring boot configuration processor\nFramework Layer", fillcolor="#F5F0FF"];
  infra3 [label="Spring boot devtools\nFramework Layer", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt1 [label="jackson3\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt2 [label="netty\nbluetape4k APIs", fillcolor="#EAF7F0"];
  runtime0 [label="In-memory / JVM\nRuntime Dependencies", fillcolor="#FFF1F1"];

  api4 -> infra0 [label="uses"];
  bt2 -> runtime0 [label="adapts"];
}

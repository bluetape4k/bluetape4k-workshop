digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Main\nktor", fillcolor="#FFF8E7"];
  entry1 [label="Abstract Ktor Test\nktor", fillcolor="#FFF8E7"];
  entry2 [label="In Memory Book Repository Test\nrepository", fillcolor="#FFF8E7"];
  entry3 [label="Book Routes Test\nroutes", fillcolor="#FFF8E7"];
  entry4 [label="Book Stream Test\nroutes", fillcolor="#FFF8E7"];
  api0 [label="Application Module\nktor", fillcolor="#EEF7FF"];
  api1 [label="In Memory Book Repository\nrepository", fillcolor="#EEF7FF"];
  api2 [label="Book Routes\nroutes", fillcolor="#EEF7FF"];
  api3 [label="Health Routes\nroutes", fillcolor="#EEF7FF"];
  service0 [label="Jackson3 Support\njson", fillcolor="#F1F8E9"];
  service1 [label="Book Service\nservice component", fillcolor="#F1F8E9"];
  service2 [label="Book\ndomain model", fillcolor="#F1F8E9"];
  service3 [label="Domain Error\ndomain model", fillcolor="#F1F8E9"];
  infra0 [label="Book Repository\nrepository", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt1 [label="core\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt2 [label="logging\nbluetape4k APIs", fillcolor="#EAF7F0"];
  runtime0 [label="In-memory / JVM\nRuntime Dependencies", fillcolor="#FFF1F1"];

  api3 -> service0 [label="delegates"];
  service3 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}

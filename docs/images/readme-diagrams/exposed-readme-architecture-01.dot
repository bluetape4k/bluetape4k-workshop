digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Web/Test Entrypoints\nExposedMvcJdbcApp\nExposedMvcVirtualThreadApp\nExposedWebfluxR2dbcApp\nProductAuditServiceTest", fillcolor="#FFF8E7"];
  api [label="MVC/WebFlux Controllers\nAuthorController\nBookController\nGlobalExceptionHandler\nOrderController", fillcolor="#EEF7FF"];
  service [label="Application Services\nProductAuditService\nAuthorService\nDatabaseInitializer\nOrderService", fillcolor="#F1F8E9"];
  infra [label="Exposed Persistence\nProduct\nProductTable\nAuthorDTO\nAuthorMappers", fillcolor="#F5F0FF"];
  runtime [label="SQL Test Runtime\nSQL / R2DBC\nRedis\nElasticsearch", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> service [label="delegates"];
  service -> infra [label="persists / publishes"];
  infra -> runtime [label="backs"];
}

digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.75",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.14,0.10"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Example Family\ndocker-compose-plugin\nexample", fillcolor="#FFF8E7"];
  infra [label="Library Layer\nio / junit5", fillcolor="#F5F0FF"];
  bt [label="bluetape4k APIs\nio / junit5", fillcolor="#EAF7F0"];
  runtime [label="Runtime\nSQL / R2DBC / Redis /\nElasticsearch", fillcolor="#FFF1F1"];

  entry -> infra [label="calls"];
  infra -> bt [label="uses"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

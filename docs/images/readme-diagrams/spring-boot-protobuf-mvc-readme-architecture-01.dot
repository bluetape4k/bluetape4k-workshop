digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Protobuf Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Course Config Test\nprotobuf", fillcolor="#FFF8E7"];
  entry2 [label="Protobuf Application IT\nprotobuf", fillcolor="#FFF8E7"];
  entry3 [label="Protobuf Converter Test\nconvert", fillcolor="#FFF8E7"];
  api0 [label="Course Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  service0 [label="Protobuf Converter\nconvert", fillcolor="#F1F8E9"];
  infra0 [label="Conurce Config\nconfiguration", fillcolor="#F5F0FF"];
  infra1 [label="Course Repository\nrepository", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt1 [label="grpc\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt2 [label="coroutines\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  runtime0 [label="In-memory / JVM\nBoot Runtime", fillcolor="#FFF1F1"];

  api0 -> service0 [label="delegates"];
  service0 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}

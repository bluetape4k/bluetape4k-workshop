  entry2 [label="Async Task Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  entry3 [label="Sync Task Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  api0 [label="Tomcat Config\nconfiguration", fillcolor="#EEF7FF"];
  api1 [label="Async Task Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  api2 [label="Sync Task Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  service0 [label="Async Config\nconfiguration", fillcolor="#F1F8E9"];
  service1 [label="Async Task Service\nservice component", fillcolor="#F1F8E9"];
  service2 [label="Sync Task Service\nservice component", fillcolor="#F1F8E9"];
  infra0 [label="Spring boot autoconfigure lib\nFramework Layer", fillcolor="#F5F0FF"];
  infra1 [label="Spring boot autoconfigure processor\nFramework Layer", fillcolor="#F5F0FF"];
  infra2 [label="Spring boot configuration processor\nFramework Layer", fillcolor="#F5F0FF"];
  infra3 [label="Spring boot devtools\nFramework Layer", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt1 [label="io\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt2 [label="jackson3\nbluetape4k APIs", fillcolor="#EAF7F0"];

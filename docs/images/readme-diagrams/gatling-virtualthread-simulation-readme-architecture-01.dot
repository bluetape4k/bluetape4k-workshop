  runtime1 [label="MongoDB\nRuntime Dependencies", fillcolor="#FFF1F1"];
  runtime2 [label="AWS / S3\nRuntime Dependencies", fillcolor="#FFF1F1"];

  api2 -> service0 [label="delegates"];

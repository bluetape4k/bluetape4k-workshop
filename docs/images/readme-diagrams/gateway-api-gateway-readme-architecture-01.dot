digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Api Gateway Demo Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Abstract Gateway Test\ngateway", fillcolor="#FFF8E7"];
  entry2 [label="Index Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  api0 [label="Gateway Config\nconfiguration", fillcolor="#EEF7FF"];
  api1 [label="Swagger Config\nconfiguration", fillcolor="#EEF7FF"];
  api2 [label="Index Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  api3 [label="Redirect Web Filter\nfilter", fillcolor="#EEF7FF"];
  infra0 [label="Spring cloud starter gateway server webflux\nFramework Layer", fillcolor="#F5F0FF"];
  infra1 [label="Spring cloud starter loadbalancer\nFramework Layer", fillcolor="#F5F0FF"];
  infra2 [label="Spring cloud test support\nFramework Layer", fillcolor="#F5F0FF"];
  infra3 [label="Spring boot autoconfigure lib\nFramework Layer", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt1 [label="jackson3\nbluetape4k APIs", fillcolor="#EAF7F0"];

  runtime1 [label="AWS / S3\nRuntime Dependencies", fillcolor="#FFF1F1"];
  runtime2 [label="Testcontainers\nRuntime Dependencies", fillcolor="#FFF1F1"];

  api3 -> infra0 [label="uses"];

digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Example Entrypoints\nApiGatewayDemoApplication\nAbstractGatewayTest\nIndexControllerTest\nGateway Api Gateway tests", fillcolor="#FFF8E7"];
  api [label="API / Adapter Layer\nGatewayConfig\nSwaggerConfig\nIndexController\nRedirectWebFilter", fillcolor="#EEF7FF"];
  infra [label="Framework Layer\nSpring cloud starter gateway\nserver webflux\nSpring cloud starter\nloadbalancer", fillcolor="#F5F0FF"];
  bt [label="bluetape4k APIs\nworkshop\njackson3\nnetty", fillcolor="#EAF7F0"];
  runtime [label="Runtime Dependencies\nRedis\nAWS / S3\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> infra [label="persists / publishes"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

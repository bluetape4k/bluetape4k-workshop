digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Docker Compose Postgres Test\ndocker", fillcolor="#FFF8E7"];
  entry1 [label="Docker Compose Redis Test\ndocker", fillcolor="#FFF8E7"];
  entry2 [label="Multiple Service Test\ndocker", fillcolor="#FFF8E7"];
  infra0 [label="Testcontainers lib\nFramework Layer", fillcolor="#F5F0FF"];
  infra1 [label="Testcontainers junit jupiter\nFramework Layer", fillcolor="#F5F0FF"];
  bt0 [label="core\nbluetape4k APIs", fillcolor="#EAF7F0"];
  runtime0 [label="SQL / R2DBC\nRuntime Dependencies", fillcolor="#FFF1F1"];
  runtime1 [label="Redis\nRuntime Dependencies", fillcolor="#FFF1F1"];
  runtime2 [label="Elasticsearch\nRuntime Dependencies", fillcolor="#FFF1F1"];

  entry2 -> infra0 [label="uses"];
  bt0 -> runtime0 [label="adapts"];
}

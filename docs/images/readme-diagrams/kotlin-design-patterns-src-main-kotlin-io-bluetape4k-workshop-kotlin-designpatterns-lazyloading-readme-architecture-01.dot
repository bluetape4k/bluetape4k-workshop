digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="lazyLoading\nExample Entrypoints", fillcolor="#FFF8E7"];
  service0 [label="Heavy\ncomponent", fillcolor="#F1F8E9"];
  service1 [label="Holder Kotlin Lazy\ncomponent", fillcolor="#F1F8E9"];
  service2 [label="Holder Native\ncomponent", fillcolor="#F1F8E9"];
  service3 [label="Holder Thread Safe\ncomponent", fillcolor="#F1F8E9"];
  service4 [label="Heavy Deferred\ncoroutines", fillcolor="#F1F8E9"];
  service5 [label="Heavy Deferred Value\ncoroutines", fillcolor="#F1F8E9"];
  runtime0 [label="SQL / R2DBC\nRuntime Dependencies", fillcolor="#FFF1F1"];

  entry0 -> service0 [label="starts"];
  service5 -> runtime0 [label="runs on"];
}

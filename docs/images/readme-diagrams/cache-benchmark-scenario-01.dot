digraph CacheBenchmark {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10];
  nodesep=0.6; ranksep=1.0;

  Benchmark [label="Benchmark (JMH)\nfindById / save", fillcolor="#E0ECFF"];
  Interface [label="ProductCacheService\ninterface", fillcolor="#EAF7EF"];

  NoCache [label="1. No Cache\ndirect DB · 1x"];
  Caffeine [label="2. Caffeine\nlocal · 60x read"];
  Redis [label="3. Redis Cache\nshared · 5x"];
  NearCache [label="4. Near Cache\n2-tier · 57x"];
  ReadThrough [label="5. Read-Through\nmanual Redis"];
  WriteThrough [label="6. Write-Through\nsync Redis+DB"];
  WriteBehind [label="7. Write-Behind\nasync flush · 2 classes"];

  H2 [shape=cylinder, label="H2 (JPA)"];
  RedisDB [shape=cylinder, label="Redis"];

  Benchmark -> Interface;
  Interface -> NoCache;
  Interface -> Caffeine;
  Interface -> Redis;
  Interface -> NearCache;
  Interface -> ReadThrough;
  Interface -> WriteThrough;
  Interface -> WriteBehind;

  NoCache -> H2;
  Caffeine -> H2;
  Redis -> RedisDB;
  NearCache -> RedisDB;
  ReadThrough -> RedisDB;
  WriteThrough -> H2;
  WriteThrough -> RedisDB;
  WriteBehind -> H2;
  WriteBehind -> RedisDB;
}

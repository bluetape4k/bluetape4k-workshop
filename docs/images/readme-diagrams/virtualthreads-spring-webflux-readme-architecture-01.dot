digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Webflux Virtual Thread App\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Abstract Webflux Virtual Thread Test\nvirtualthread", fillcolor="#FFF8E7"];
  entry2 [label="Abstract Dispatcher Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  entry3 [label="Custom Dispatcher Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  entry4 [label="Default Dispatcher Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  api0 [label="Netty Config\nconfiguration", fillcolor="#EEF7FF"];
  api1 [label="Scheduling Config\nconfiguration", fillcolor="#EEF7FF"];
  api2 [label="Abstract Dispatcher Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  api3 [label="Custom Dispatcher Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  api4 [label="Default Dispatcher Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  service0 [label="Banner\ndomain model", fillcolor="#F1F8E9"];
  service1 [label="Dispatcher Type\ndomain model", fillcolor="#F1F8E9"];
  infra0 [label="Async Config\nconfiguration", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Coroutine APIs", fillcolor="#EAF7F0"];
  bt1 [label="core\nbluetape4k Coroutine APIs", fillcolor="#EAF7F0"];
  bt2 [label="virtualthread\nbluetape4k Coroutine APIs", fillcolor="#EAF7F0"];
  runtime0 [label="SQL / R2DBC\nJVM Thread Runtime", fillcolor="#FFF1F1"];
  runtime1 [label="Elasticsearch\nJVM Thread Runtime", fillcolor="#FFF1F1"];
  runtime2 [label="Testcontainers\nJVM Thread Runtime", fillcolor="#FFF1F1"];

  api4 -> service0 [label="delegates"];
  service1 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}

digraph Gateway {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10];
  nodesep=0.8; ranksep=1.5;

  Client [label="HTTP Client", fillcolor="#E0ECFF"];

  subgraph cluster_gw {
    label="API Gateway\n(Spring Cloud Gateway)";
    style=rounded; fillcolor="#EAF7EF";
    Routing [label="Route Rules\n(YAML-driven)"];
    RateLimit [label="Rate Limit\nBucket4j + Lettuce\n50 req/10s"];
    Swagger [label="Swagger UI\nAggregated"];
    Redirect [label="RedirectWebFilter\n/ → /swagger-ui"];
  }

  CustomerService [label="Customer Service\nport 8081"];
  OrderService [label="Order Service\nport 8082"];
  Redis [shape=cylinder, label="Redis"];

  Client -> Routing;
  Routing -> CustomerService;
  Routing -> OrderService;
  Routing -> RateLimit;
  RateLimit -> Redis;
  Routing -> Swagger;
}

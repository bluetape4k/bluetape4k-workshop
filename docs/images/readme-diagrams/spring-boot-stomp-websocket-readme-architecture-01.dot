digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Stomp Web Socket Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Greeting Integration Test\nwebsocket", fillcolor="#FFF8E7"];
  entry2 [label="Test Session Handler\nwebsocket", fillcolor="#FFF8E7"];
  api0 [label="Tomcat Config\nconfiguration", fillcolor="#EEF7FF"];
  api1 [label="Greeting Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  service0 [label="Web Socket Config\nconfiguration", fillcolor="#F1F8E9"];
  service1 [label="Greeting\ndomain model", fillcolor="#F1F8E9"];
  service2 [label="Hello Message\ndomain model", fillcolor="#F1F8E9"];
  infra0 [label="Spring boot autoconfigure lib\nSpring Boot Layer", fillcolor="#F5F0FF"];
  infra1 [label="Spring boot autoconfigure processor\nSpring Boot Layer", fillcolor="#F5F0FF"];
  infra2 [label="Spring boot configuration processor\nSpring Boot Layer", fillcolor="#F5F0FF"];
  infra3 [label="Spring boot devtools\nSpring Boot Layer", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt1 [label="core\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt2 [label="junit5\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  runtime0 [label="SQL / R2DBC\nBoot Runtime", fillcolor="#FFF1F1"];

  api1 -> service0 [label="delegates"];
  service2 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}

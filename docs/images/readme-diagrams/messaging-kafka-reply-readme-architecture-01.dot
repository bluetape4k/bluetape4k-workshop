  api0 [label="Ping Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  api1 [label="Pong Handler\npong", fillcolor="#EEF7FF"];
  infra0 [label="Spring kafka lib\nSpring Kafka Layer", fillcolor="#F5F0FF"];
  infra1 [label="Spring kafka test\nSpring Kafka Layer", fillcolor="#F5F0FF"];
  infra2 [label="Spring data commons\nSpring Kafka Layer", fillcolor="#F5F0FF"];
  infra3 [label="Spring boot autoconfigure lib\nSpring Kafka Layer", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Kafka APIs", fillcolor="#EAF7F0"];
  bt1 [label="kafka4\nbluetape4k Kafka APIs", fillcolor="#EAF7F0"];
  bt2 [label="testcontainers\nbluetape4k Kafka APIs", fillcolor="#EAF7F0"];
  runtime0 [label="Kafka\nKafka Broker Runtime", fillcolor="#FFF1F1"];
  runtime1 [label="Testcontainers\nKafka Broker Runtime", fillcolor="#FFF1F1"];

  api1 -> infra0 [label="uses"];
  bt2 -> runtime0 [label="adapts"];
}

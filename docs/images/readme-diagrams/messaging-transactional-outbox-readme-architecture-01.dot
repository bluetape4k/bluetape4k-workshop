  api2 [label="Outbox Event Table\ndomain model", fillcolor="#EEF7FF"];
  service0 [label="Order Response\napi", fillcolor="#F1F8E9"];
  service1 [label="Exposed Config\nconfiguration", fillcolor="#F1F8E9"];
  service2 [label="Kafka Config\nconfiguration", fillcolor="#F1F8E9"];
  service3 [label="Order Table\ndomain model", fillcolor="#F1F8E9"];
  service4 [label="Outbox Publisher\noutbox", fillcolor="#F1F8E9"];
  service5 [label="Order Request\napi", fillcolor="#F1F8E9"];
  infra0 [label="Outbox Event\noutbox", fillcolor="#F5F0FF"];
  infra1 [label="Outbox Status\noutbox", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Kafka APIs", fillcolor="#EAF7F0"];

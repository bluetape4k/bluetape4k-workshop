digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Messaging App/Test Surface\nOutboxApplication\nAbstractOutboxTest\nOutboxTransactionTest\nMessaging Transactional Outbox", fillcolor="#FFF8E7"];
  api [label="Producer / Consumer Adapters\nOrderController\nOrderService\nOutboxEventTable", fillcolor="#EEF7FF"];
  service [label="Message Workflow\nOrderResponse\nExposedConfig\nKafkaConfig\nOrderTable", fillcolor="#F1F8E9"];
  infra [label="Kafka Topic Layer\nOutboxEvent\nOutboxStatus", fillcolor="#F5F0FF"];
  bt [label="bluetape4k Kafka APIs\nworkshop\njunit5\nassertions", fillcolor="#EAF7F0"];
  runtime [label="Kafka Broker Runtime\nSQL / R2DBC\nKafka\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> service [label="delegates"];
  service -> infra [label="persists / publishes"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

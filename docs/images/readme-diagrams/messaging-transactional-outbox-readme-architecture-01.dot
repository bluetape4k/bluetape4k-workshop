  bt2 [label="assertions\nbluetape4k Kafka APIs", fillcolor="#EAF7F0"];
  runtime0 [label="SQL / R2DBC\nKafka Broker Runtime", fillcolor="#FFF1F1"];
  runtime1 [label="Kafka\nKafka Broker Runtime", fillcolor="#FFF1F1"];

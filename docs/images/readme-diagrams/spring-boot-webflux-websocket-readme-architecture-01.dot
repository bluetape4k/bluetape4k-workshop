digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Websocket Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Websocket Application Test\nwebflux", fillcolor="#FFF8E7"];
  api0 [label="Netty Config\nconfiguration", fillcolor="#EEF7FF"];
  api1 [label="Reactive Web Socket Configuration\nconfiguration", fillcolor="#EEF7FF"];
  api2 [label="Sample Webflux Router\nconfiguration", fillcolor="#EEF7FF"];
  api3 [label="Reactive Web Socket Handler\nhandler", fillcolor="#EEF7FF"];
  service0 [label="Quote Generator\nservice component", fillcolor="#F1F8E9"];
  service1 [label="Models\ndomain model", fillcolor="#F1F8E9"];
  infra0 [label="Spring cloud dependencies get\nSpring Boot Layer", fillcolor="#F5F0FF"];
  infra1 [label="Spring boot4 dependencies get\nSpring Boot Layer", fillcolor="#F5F0FF"];
  infra2 [label="Spring boot autoconfigure lib\nSpring Boot Layer", fillcolor="#F5F0FF"];
  infra3 [label="Spring boot autoconfigure processor\nSpring Boot Layer", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt1 [label="idgenerators\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt2 [label="junit5\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  runtime0 [label="In-memory / JVM\nBoot Runtime", fillcolor="#FFF1F1"];

  api3 -> service0 [label="delegates"];
  service1 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}

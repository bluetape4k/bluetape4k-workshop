digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Sample Bootstraps\nSpringCloudAwsS3Sample\nStorageApplication\nAbstractSpringCloudAwsS3SampleTest\nSpringCloudAwsS3Test", fillcolor="#FFF8E7"];
  api [label="S3 Example Modules\ns3 spring cloud\nstorage abstraction", fillcolor="#EEF7FF"];
  service [label="Storage Workflow\nLocalStorageService\nS3Config\nS3PresignedStorageService\nS3StorageService", fillcolor="#F1F8E9"];
  runtime [label="LocalStack / S3\nAWS / S3\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> service [label="delegates"];
  service -> runtime [label="backs"];
}

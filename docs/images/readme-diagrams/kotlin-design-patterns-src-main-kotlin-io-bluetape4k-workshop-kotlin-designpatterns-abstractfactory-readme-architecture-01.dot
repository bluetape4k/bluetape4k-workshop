digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.75",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.14,0.10"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Entry / Tests\nKotlin Design Patterns\nKotlin DesignPatterns\nAbstractFactory tests", fillcolor="#FFF8E7"];
  service [label="Service / Domain\nArmy / Castle / FactoryMaker\n/ King", fillcolor="#F1F8E9"];
  runtime [label="Runtime\nSQL / R2DBC / AWS / S3", fillcolor="#FFF1F1"];

  entry -> service [label="calls"];
  service -> runtime [label="uses"];
}

digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Cache Resilience Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Resilient Cache Service Test\nresilience", fillcolor="#FFF8E7"];
  service0 [label="Resilient Product Service\nservice component", fillcolor="#F1F8E9"];
  infra0 [label="Resilient Cache Config\nconfiguration", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt1 [label="junit5\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt2 [label="testcontainers\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  runtime0 [label="Redis\nBoot Runtime", fillcolor="#FFF1F1"];
  runtime1 [label="Testcontainers\nBoot Runtime", fillcolor="#FFF1F1"];

  entry1 -> service0 [label="starts"];
  service0 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}

digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Data Demo Surface\nWebfluxR2dbcApplication\nAbstractWebfluxR2dbcApplicationTest\nWebfluxR2dbcConfigurationTest\nSpring Data R2dbc Webflux tests", fillcolor="#FFF8E7"];
  api [label="Web/Data Adapters\nNettyConfig\nWebfluxR2dbcConfiguration\nUserController\nUserHandler", fillcolor="#EEF7FF"];
  service [label="Data Service Layer\nUserService", fillcolor="#F1F8E9"];
  infra [label="Repository Layer\nErrorMessage\nUser\nUserDTO\nUserRepository", fillcolor="#F5F0FF"];
  bt [label="bluetape4k Data APIs\nworkshop\njunit5\ncoroutines", fillcolor="#EAF7F0"];
  runtime [label="Database Runtime\nSQL / R2DBC", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> service [label="delegates"];
  service -> infra [label="persists / publishes"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

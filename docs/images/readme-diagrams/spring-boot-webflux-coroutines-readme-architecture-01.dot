digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Coroutine Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Abstract Coroutine Application Test\ncoroutines", fillcolor="#FFF8E7"];
  entry2 [label="Default Coroutine Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  entry3 [label="IO Coroutine Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  entry4 [label="VT Coroutine Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  api0 [label="Netty Config\nconfiguration", fillcolor="#EEF7FF"];
  api1 [label="Default Coroutine Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  api2 [label="IO Coroutine Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  api3 [label="VT Coroutine Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  api4 [label="Coroutine Handler\nhandler", fillcolor="#EEF7FF"];
  service0 [label="Banner\ndomain model", fillcolor="#F1F8E9"];
  infra0 [label="Web Client Config\nconfiguration", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt1 [label="io\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt2 [label="jackson3\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  runtime0 [label="In-memory / JVM\nBoot Runtime", fillcolor="#FFF1F1"];

  api4 -> service0 [label="delegates"];
  service0 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}

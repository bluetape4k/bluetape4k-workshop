    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Main\nmovierating", fillcolor="#FFF8E7"];
  entry1 [label="Movie Rating Vertice Test\nmovierating", fillcolor="#FFF8E7"];
  api0 [label="Movie Rating Verticle\nmovierating", fillcolor="#EEF7FF"];
  bt0 [label="io\nbluetape4k APIs", fillcolor="#EAF7F0"];

digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Gateway Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Gateway Application Test\ngateway", fillcolor="#FFF8E7"];
  entry2 [label="Demo Routes Test\nroutes", fillcolor="#FFF8E7"];
  api0 [label="Rate Limit Headers\ngateway", fillcolor="#EEF7FF"];

  api2 [label="Netty Config\nconfiguration", fillcolor="#EEF7FF"];
  api3 [label="Rate Limit Config\nconfiguration", fillcolor="#EEF7FF"];
  api4 [label="Fallback Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  infra0 [label="Spring boot4 dependencies\nFramework Layer", fillcolor="#F5F0FF"];
  infra1 [label="Spring cloud dependencies\nFramework Layer", fillcolor="#F5F0FF"];
  infra2 [label="Spring cloud starter gateway server webflux\nFramework Layer", fillcolor="#F5F0FF"];
  infra3 [label="Spring cloud starter circuitbreaker reactor resilience4j\nFramework Layer", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt1 [label="jackson3\nbluetape4k APIs", fillcolor="#EAF7F0"];

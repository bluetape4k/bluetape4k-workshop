digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Chaos Application\napplication bootstrap", fillcolor="#FFF8E7"];
  entry1 [label="Abstract Chaos Application Test\nchaos", fillcolor="#FFF8E7"];
  entry2 [label="Student Controller Test\nHTTP adapter", fillcolor="#FFF8E7"];
  api0 [label="Student Controller\nHTTP adapter", fillcolor="#EEF7FF"];
  service0 [label="Student Service\nservice component", fillcolor="#F1F8E9"];
  service1 [label="Student\ndomain model", fillcolor="#F1F8E9"];
  infra0 [label="Student Jdbc Repository\nrepository", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt1 [label="core\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  bt2 [label="junit5\nbluetape4k Boot APIs", fillcolor="#EAF7F0"];
  runtime0 [label="SQL / R2DBC\nBoot Runtime", fillcolor="#FFF1F1"];
  runtime1 [label="AWS / S3\nBoot Runtime", fillcolor="#FFF1F1"];

  api0 -> service0 [label="delegates"];

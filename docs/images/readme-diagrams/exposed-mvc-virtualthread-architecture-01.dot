digraph ExposedMvcVT {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9];
  newrank=true; nodesep=0.7; ranksep=1.0;

  subgraph cluster_presentation {
    label="Presentation"; style=rounded;
    AuthorController [label="AuthorController\n/api/v1/authors"];
    BookController [label="BookController\n/api/v1/books"];
    OrderController [label="OrderController\n/api/v1/orders"];
    ProductController [label="ProductController\n/api/v1/products"];
  }
  subgraph cluster_service {
    label="Service"; style=rounded;
    AuthorService [label="AuthorService\nvirtualFuture { transaction {} }"];
    OrderService [label="OrderService\nvirtualFuture { transaction {} }\nlock ordering + forUpdate"];
  }
  subgraph cluster_repository {
    label="Repository"; style=rounded;
    AuthorRepository [label="AuthorRepository\nVirtualFuture<T>"];
    BookRepository [label="BookRepository\nVirtualFuture<T>"];
    OrderRepository [label="OrderRepository\nVirtualFuture<T>"];
    OrderLineRepository [label="OrderLineRepository\nVirtualFuture<T>"];
    ProductRepository [label="ProductRepository\nVirtualFuture<T>"];
  }
  subgraph cluster_schema {
    label="Schema"; style=rounded;
    AuthorTable [label="AuthorTable\nTable"];
    BookTable [label="BookTable\nTable · FK→Author"];
    OrderTable [label="OrderTable\nTable · status enum"];
    OrderLineTable [label="OrderLineTable\nTable · FK→Order,Product"];
    ProductTable [label="ProductTable\nTable · stock+price"];
  }
  subgraph cluster_infra {
    label="VT Infrastructure"; style=rounded;
    TomcatConfig [label="TomcatConfig\nProtocolHandlerCustomizer"];
    VTExecutor [label="VT Executor\nnewVirtualThreadPerTask"];
    DatabaseConfig [label="DatabaseConfig\nHikariCP pool"];
  }
  PostgreSQL [shape=cylinder, label="PostgreSQL"];

  AuthorController -> AuthorService;
  BookController -> AuthorService;
  OrderController -> OrderService;
  ProductController -> OrderService;

  AuthorService -> AuthorRepository;
  AuthorService -> BookRepository;
  OrderService -> OrderRepository;
  OrderService -> OrderLineRepository;
  OrderService -> ProductRepository;

  AuthorRepository -> AuthorTable;
  BookRepository -> BookTable;
  OrderRepository -> OrderTable;
  OrderLineRepository -> OrderLineTable;
  ProductRepository -> ProductTable;

  BookTable -> AuthorTable [style=dashed, label="FK"];
  OrderLineTable -> OrderTable [style=dashed, label="FK"];
  OrderLineTable -> ProductTable [style=dashed, label="FK"];

  TomcatConfig -> VTExecutor;
  VTExecutor -> AuthorService [style=dashed];
  VTExecutor -> OrderService [style=dashed];

  AuthorTable -> PostgreSQL;
  OrderTable -> PostgreSQL;
  ProductTable -> PostgreSQL;
}

digraph MultiTenant {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];
  nodesep=0.8; ranksep=1.2;

  TenantA [label="Tenant A\nTenantId(acme)", fillcolor="#E0ECFF"];
  TenantB [label="Tenant B\nTenantId(globex)", fillcolor="#F1ECFF"];

  Service [label="TenantInvoiceService\ncomposes all boundaries\nTenantKeyFactory", fillcolor="#EAF7EF"];

  Repo [label="Repository\ntenant-scoped queries\nLongJdbcRepository", fillcolor="#EAF7EF"];
  Cache [label="Cache\nin-memory\nConcurrentHashMap", fillcolor="#FFF3D9"];
  Lock [label="Lock\nin-memory\nReentrantLock", fillcolor="#F1ECFF"];
  Rate [label="Rate Limiter\nin-memory\nfixed-window", fillcolor="#FDECEF"];
  Metrics [label="Metrics\nMicrometer\ntag: tenant", fillcolor="#E8F3FF"];

  DB [shape=cylinder, label="H2 + Exposed", fillcolor="#FFF3D9"];

  TenantA -> Service;
  TenantB -> Service;
  Service -> Repo;
  Service -> Cache;
  Service -> Lock;
  Service -> Rate;
  Service -> Metrics;
  Repo -> DB;
}

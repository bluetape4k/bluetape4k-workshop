digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Spring Data Redis - Streams Examples\nData Demo Surface", fillcolor="#FFF8E7"];
  api0 [label="Capturing Stream Listener\nsync", fillcolor="#EEF7FF"];
  infra0 [label="Sensor Data\ncomponent", fillcolor="#F5F0FF"];
  runtime0 [label="Redis\nDatabase Runtime", fillcolor="#FFF1F1"];

  api0 -> infra0 [label="uses"];
  infra0 -> runtime0 [label="backs"];
}

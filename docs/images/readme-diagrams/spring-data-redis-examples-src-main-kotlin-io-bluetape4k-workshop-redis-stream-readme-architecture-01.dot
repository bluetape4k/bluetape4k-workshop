digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.75",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.14,0.10"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Entry / Tests\nSpring Data Redis Examples\nRedis Stream tests", fillcolor="#FFF8E7"];
  api [label="API / Adapter\nCapturingStreamListener", fillcolor="#EEF7FF"];
  infra [label="Repository / Infra\nSensorData", fillcolor="#F5F0FF"];
  runtime [label="Runtime\nRedis", fillcolor="#FFF1F1"];

  entry -> api [label="calls"];
  api -> infra [label="uses"];
  infra -> runtime [label="uses"];
}

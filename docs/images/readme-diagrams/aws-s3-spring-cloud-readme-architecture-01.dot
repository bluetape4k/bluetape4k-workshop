digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Sample Bootstraps\nSpringCloudAwsS3Sample\nAbstractSpringCloudAwsS3SampleTest\nSpringCloudAwsS3Test\nAws S3 Spring Cloud tests", fillcolor="#FFF8E7"];
  infra [label="Spring Cloud AWS\nSpring cloud aws starter\nSpring cloud aws s3\nSpring boot autoconfigure lib\nSpring boot autoconfigure", fillcolor="#F5F0FF"];
  bt [label="bluetape4k AWS APIs\nworkshop\naws\ntestcontainers", fillcolor="#EAF7F0"];
  runtime [label="LocalStack / S3\nAWS / S3\nTestcontainers", fillcolor="#FFF1F1"];

  entry -> infra [label="persists / publishes"];
  infra -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

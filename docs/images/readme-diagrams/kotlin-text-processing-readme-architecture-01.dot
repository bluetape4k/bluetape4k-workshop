digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Language Detection Service Test\ndetection", fillcolor="#FFF8E7"];
  entry1 [label="Abuse Word Filter Test\nfilter", fillcolor="#FFF8E7"];
  entry2 [label="Text Normalizer Test\nnormalize", fillcolor="#FFF8E7"];
  api0 [label="Abuse Word Filter\nfilter", fillcolor="#EEF7FF"];
  api1 [label="Text Normalizer\nnormalize", fillcolor="#EEF7FF"];
  service0 [label="Language Detection Service\nservice component", fillcolor="#F1F8E9"];
  bt0 [label="text\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt1 [label="logging\nbluetape4k APIs", fillcolor="#EAF7F0"];
  bt2 [label="junit5\nbluetape4k APIs", fillcolor="#EAF7F0"];
  runtime0 [label="In-memory / JVM\nRuntime Dependencies", fillcolor="#FFF1F1"];

  api1 -> service0 [label="delegates"];
  bt2 -> runtime0 [label="adapts"];
}

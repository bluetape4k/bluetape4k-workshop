digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry [label="Entry & Verification\nLanguageDetectionServiceTest\nAbuseWordFilterTest\nKotlin Text Processing tests", fillcolor="#FFF8E7"];
  api [label="API & Adapters\nAbuseWordFilter\nTextNormalizer", fillcolor="#EEF7FF"];
  service [label="Service & Domain\nLanguageDetectionService", fillcolor="#F1F8E9"];
  bt [label="bluetape4k APIs\ntext\nlogging\njunit5", fillcolor="#EAF7F0"];
  runtime [label="Runtime\nIn-memory / JVM", fillcolor="#FFF1F1"];

  entry -> api [label="invokes"];
  api -> service [label="delegates"];
  service -> bt [label="extends"];
  bt -> runtime [label="adapts"];
}

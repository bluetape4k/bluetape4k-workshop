digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.70",
    ranksep="0.95",
    splines=ortho,
    outputorder=edgesfirst
  ];
  node [
    shape=box,
    style="rounded,filled",
    penwidth=1.4,
    color="#88A3B5",
    fillcolor="#F6FAFF",
    fontname="Architects Daughter",
    fontsize=14,
    margin="0.20,0.16"
  ];
  edge [
    color="#637383",
    arrowsize=0.8,
    penwidth=1.5,
    fontname="Comic Mono",
    fontsize=11
  ];

  entry0 [label="Product Audit Service Test\njavers", fillcolor="#FFF8E7"];
  service0 [label="Product Audit Service\nservice component", fillcolor="#F1F8E9"];
  infra0 [label="Product\ndomain model", fillcolor="#F5F0FF"];
  infra1 [label="Product Table\ndomain model", fillcolor="#F5F0FF"];
  bt0 [label="workshop\nbluetape4k Data APIs", fillcolor="#EAF7F0"];
  bt1 [label="javers\nbluetape4k Data APIs", fillcolor="#EAF7F0"];
  bt2 [label="assertions\nbluetape4k Data APIs", fillcolor="#EAF7F0"];
  runtime0 [label="SQL / R2DBC\nSQL Test Runtime", fillcolor="#FFF1F1"];
  runtime1 [label="Redis\nSQL Test Runtime", fillcolor="#FFF1F1"];

  entry0 -> service0 [label="starts"];
  service0 -> infra0 [label="persists / publishes"];
  bt2 -> runtime0 [label="adapts"];
}
